#include <bits/stdc++.h>
using namespace std;
 
int main() {
    ios::sync_with_stdio(0);
    cin.tie(0);
 
    int t;
    cin >> t;
    while (t--) {
        int n , k;
        cin >> n >> k;
        int a[n], count = 0;
 
        for(int i = 0; i < n; i++){
            cin >> a[i];
            if(a[i] == k){
                count++;
            }
        }
 
        if(count > 0){
            cout << "YES
";
        }else{
            cout << "NO
";
        }
 
    }
 
    return 0;
}